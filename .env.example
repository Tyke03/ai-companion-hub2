# Public (browser-visible) Supabase configuration — required by the SPA.
# When these are missing or malformed, AI generation and the community gallery
# degrade gracefully instead of crashing. Values are supplied per-environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Supabase Edge Function secrets (set in the Supabase dashboard, never in the
# frontend or in this file). At least one provider key is required for the
# AI features to report as available.
# VENICE_API_KEY=
# OPENROUTER_API_KEY=
# LOVABLE_API_KEY=
